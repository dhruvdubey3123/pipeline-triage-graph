   "mart_supplier_performance": "changed",
   "rpt_revenue_dashboard": "changed",
   "rpt_regional_summary": "changed"
  },
  "fix_targets": [
   "stg_lineitem"
  ],
  "family": "type_drift",
  "split": "evolve",
